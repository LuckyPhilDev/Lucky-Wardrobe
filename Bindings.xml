<Bindings>
	<Binding name="LUCKYWARDROBE_PREVIEW_SCROLL_UP" hidden="true">
		local LuckyWardrobe = LibStub("AceAddon-3.0"):GetAddon("LuckyWardrobe")
		LuckyWardrobe.preview.previewModel:SetFacing(LuckyWardrobe.preview.previewModel:GetFacing() +.1)
	</Binding>
	<Binding name="LUCKYWARDROBE_PREVIEW_SCROLL_DOWN" hidden="true">
		local LuckyWardrobe = LibStub("AceAddon-3.0"):GetAddon("LuckyWardrobe")
		LuckyWardrobe.preview.previewModel:SetFacing(LuckyWardrobe.preview.previewModel:GetFacing() -.1)
	</Binding>

	<Binding name= "LUCKYWARDROBE_BINDING_TOGGLE_DRESSINGROOM" hidden="false" category="BINDING_HEADER_LUCKYWARDROBE">
		LuckyWardrobe:ToggleDressingRoom()
	</Binding>

	<Binding name= "LUCKYWARDROBE_BINDING_TARGETGEAR" hidden="false"  category="BINDING_HEADER_LUCKYWARDROBE">
		DressUpFrame_Show(DressUpFrame)
		LuckyWardrobe:SetTargetGear()
	</Binding>
	<Binding name= "LUCKYWARDROBE_BINDING_TARGETMODEL" hidden="false" category="BINDING_HEADER_LUCKYWARDROBE">
		DressUpFrame_Show(DressUpFrame)
		LuckyWardrobe:SetTarget()
	</Binding>
	<Binding name= "LUCKYWARDROBE_BINDING_PLAYERMODEL" hidden="false" category="BINDING_HEADER_LUCKYWARDROBE">
		DressUpFrame_Show(DressUpFrame)
		LuckyWardrobe:SetTargetGear(true)
	</Binding>
</Bindings>
