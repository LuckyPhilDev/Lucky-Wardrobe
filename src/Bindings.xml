<Bindings>
	<Binding name="LUCKYWARDROBE_PREVIEW_SCROLL_UP" hidden="true">
		local LuckysBetterWardrobe = LibStub("AceAddon-3.0"):GetAddon("LuckysBetterWardrobe")
		LuckysBetterWardrobe.preview.previewModel:SetFacing(LuckysBetterWardrobe.preview.previewModel:GetFacing() +.1)
	</Binding>
	<Binding name="LUCKYWARDROBE_PREVIEW_SCROLL_DOWN" hidden="true">
		local LuckysBetterWardrobe = LibStub("AceAddon-3.0"):GetAddon("LuckysBetterWardrobe")
		LuckysBetterWardrobe.preview.previewModel:SetFacing(LuckysBetterWardrobe.preview.previewModel:GetFacing() -.1)
	</Binding>

	<Binding name="LUCKYWARDROBE_TOGGLE_SET_LIST" header="LUCKYWARDROBE">
		local LuckysBetterWardrobe = LibStub("AceAddon-3.0"):GetAddon("LuckysBetterWardrobe")
		LuckysBetterWardrobe.SetCompletion:Toggle()
	</Binding>

</Bindings>
