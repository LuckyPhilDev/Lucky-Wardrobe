package-as: LuckysBetterWardrobe

manual-changelog:
    filename: CHANGELOG.md
    markup-type: markdown

externals:
    src/Libs/LibStub: https://repos.wowace.com/wow/libstub/trunk
    src/Libs/CallbackHandler-1.0: https://repos.wowace.com/wow/callbackhandler/trunk/CallbackHandler-1.0
    src/Libs/AceAddon-3.0: https://repos.wowace.com/wow/ace3/trunk/AceAddon-3.0
    src/Libs/AceConsole-3.0: https://repos.wowace.com/wow/ace3/trunk/AceConsole-3.0
    src/Libs/AceGUI-3.0: https://repos.wowace.com/wow/ace3/trunk/AceGUI-3.0
    src/Libs/AceDB-3.0: https://repos.wowace.com/wow/ace3/trunk/AceDB-3.0
    src/Libs/AceEvent-3.0: https://repos.wowace.com/wow/ace3/trunk/AceEvent-3.0
    src/Libs/AceHook-3.0: https://repos.wowace.com/wow/ace3/trunk/AceHook-3.0
    src/Libs/AceLocale-3.0: https://repos.wowace.com/wow/ace3/trunk/AceLocale-3.0
    src/Libs/AceSerializer-3.0: https://repos.wowace.com/wow/ace3/trunk/AceSerializer-3.0
    src/Libs/LibArmorToken-1.0: https://repos.curseforge.com/wow/libarmortoken-1-0
    #src/Libs/LibAppropriateitems-1.0: https://repos.curseforge.com/wow/libappropriateitems-1-0

enable-nolib-creation: no

ignore:
    - README.md
    - images
    - src/Libs/test.txt
    - src/Libs/LibArmorToken-1.0/LibArmorToken-1.0.toc
    - src/Libs/LibArmorToken-1.0/LibStub.lua

move-folders:
    LuckysBetterWardrobe/BetterWardrobe_SourceData: BetterWardrobe_SourceData
    LuckysBetterWardrobe/src: LuckysBetterWardrobe
